PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/file-manager
JWT_SECRET=supersecretjwttokenkeythatshouldbelongandsecure
# ENCRYPTION_SECRET must be 32 bytes (64 hex characters)
ENCRYPTION_SECRET=8f515e0a0a56f6c99276bcbbbfcd5123d4567890abcdef0123456789abcdef01
UPLOAD_DIR=./uploads
NODE_ENV=production

# Storage provider options: local, s3, r2, azure, gcs, b2
STORAGE_PROVIDER=local
LOCAL_UPLOAD_PATH=./uploads
AWS_REGION=us-east-1
AWS_BUCKET=aethervault-s3
R2_BUCKET=aethervault-r2
AZURE_CONTAINER=aethervault-container
GCS_BUCKET=aethervault-gcs

# Email options: smtp, sendgrid, mailgun, ses
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@aethervault.io
